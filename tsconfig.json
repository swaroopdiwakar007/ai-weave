{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ai-weave/core": ["packages/core/src/index.ts"],
      "@ai-weave/core/testing": ["packages/core/src/testing/index.ts"],
      "@ai-weave/anthropic": ["packages/anthropic/src/index.ts"],
      "@ai-weave/openai": ["packages/openai/src/index.ts"],
      "@ai-weave/gemini": ["packages/gemini/src/index.ts"],
      "@ai-weave/web": ["packages/web/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "tests", "examples/*/src", "*.ts"]
}
