{
  "name": "@ai-weave/openai",
  "version": "0.1.0",
  "description": "OpenAI (and OpenAI-compatible) provider for ai-weave.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swaroopdiwakar007/ai-weave.git",
    "directory": "packages/openai"
  },
  "homepage": "https://github.com/swaroopdiwakar007/ai-weave/tree/main/packages/openai#readme",
  "bugs": {
    "url": "https://github.com/swaroopdiwakar007/ai-weave/issues"
  },
  "type": "module",
  "keywords": [
    "openai",
    "gpt"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-weave/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
