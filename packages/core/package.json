{
  "name": "@ai-weave/core",
  "version": "0.1.0",
  "description": "Core of ai-weave: createWeave, tasks (generate, extract, classify, summarize), structured output, retries and fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swaroopdiwakar007/ai-weave.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/swaroopdiwakar007/ai-weave/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/swaroopdiwakar007/ai-weave/issues"
  },
  "type": "module",
  "keywords": [
    "ai",
    "llm",
    "structured-output",
    "extraction"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "zod": "^4.1.0"
  }
}
